#!/usr/bin/env python3
"""Backend for the Kinesis Advantage360 (SmartSet) Omarchy plugin.

Talks to the keyboard's v-Drive (a plain USB mass-storage device that only
appears once the user triggers the onboard "connect v-Drive" shortcut) and
to the plain-text layout files it exposes. Every command prints one JSON
object to stdout: {"ok": true, ...} or {"ok": false, "error": "..."}.

Direct Programming Guide: layouts/<1-9>.txt hold remaps/macros under layer
headers (<base> <keypad> <function1> <function2> <function3>); a line is
`[position]>[action]` for a single remap or `{...}{position}>{action}...`
for a macro; a leading "*" disables a line; when two lines target the same
position the one lower in the file wins. settings.txt is never touched.
"""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

PLUGIN_DIR = Path(__file__).resolve().parent.parent
DATA_DIR = PLUGIN_DIR / "data"
VENDOR_ID = "29ea"
LAYERS = ["base", "keypad", "function1", "function2", "function3"]
LAYER_HEADER_RE = re.compile(r"^<(base|keypad|function1|function2|function3)>$", re.IGNORECASE)
GROUP_RE = re.compile(r"[\[{]([^\]}]*)[\]}]")


def ok(**kw):
    print(json.dumps({"ok": True, **kw}))


def err(msg):
    print(json.dumps({"ok": False, "error": msg}))
    sys.exit(1)


def load_data(name):
    return json.loads((DATA_DIR / name).read_text())


# --------------------------------------------------------------------------
# v-Drive detection / mount / eject
# --------------------------------------------------------------------------

def _usb_block_devices():
    out = subprocess.run(
        ["lsblk", "-J", "-o", "NAME,TRAN,MOUNTPOINT,FSTYPE"],
        capture_output=True, text=True, check=True,
    )
    data = json.loads(out.stdout)
    found = []

    def walk(devices, top_tran=None):
        for d in devices:
            tran = d.get("tran") or top_tran
            if tran == "usb" and d.get("fstype"):
                found.append({"name": d["name"], "mountpoint": d.get("mountpoint")})
            for child in d.get("children") or []:
                walk([child], tran)

    walk(data.get("blockdevices") or [])
    return found


def _udev_vendor_id(devname):
    out = subprocess.run(
        ["udevadm", "info", "-q", "property", f"/dev/{devname}"],
        capture_output=True, text=True,
    )
    for line in out.stdout.splitlines():
        if line.startswith("ID_VENDOR_ID="):
            return line.split("=", 1)[1]
    return None


def find_vdrive():
    for dev in _usb_block_devices():
        if _udev_vendor_id(dev["name"]) == VENDOR_ID:
            return dev
    return None


def cmd_detect(_args):
    dev = find_vdrive()
    if not dev:
        ok(state="no-drive")
        return
    ok(state="mounted" if dev["mountpoint"] else "unmounted", **dev)


def cmd_mount(_args):
    dev = find_vdrive()
    if not dev:
        err("v-Drive not found. Trigger the 'connect v-Drive' shortcut on the keyboard first.")
    if dev["mountpoint"]:
        ok(state="mounted", **dev)
        return
    r = subprocess.run(
        ["udisksctl", "mount", "-b", f"/dev/{dev['name']}", "--no-user-interaction"],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        err(f"udisksctl mount failed: {r.stderr.strip() or r.stdout.strip()}")
    m = re.search(r"at (.+)$", r.stdout.strip())
    ok(state="mounted", name=dev["name"], mountpoint=m.group(1) if m else None)


def cmd_eject(_args):
    dev = find_vdrive()
    if not dev:
        err("v-Drive not found.")
    if dev["mountpoint"]:
        r = subprocess.run(
            ["udisksctl", "unmount", "-b", f"/dev/{dev['name']}", "--no-user-interaction"],
            capture_output=True, text=True,
        )
        if r.returncode != 0:
            err(f"udisksctl unmount failed: {r.stderr.strip() or r.stdout.strip()}")
    ok(state="ejected")


def vdrive_mountpoint():
    dev = find_vdrive()
    if not dev or not dev["mountpoint"]:
        err("v-Drive is not mounted. Run 'mount' first.")
    return Path(dev["mountpoint"])


# --------------------------------------------------------------------------
# layouts/<n>.txt parsing and serialization
# --------------------------------------------------------------------------

def layout_path(mountpoint, profile):
    if profile not in range(1, 10):
        err("profile must be 1-9 (profile 0 has no layout file)")
    # Confirmed against a real v-Drive: files are "layout1.txt".."layout9.txt",
    # not "1.txt".."9.txt" as the wording in the official manual suggests.
    return mountpoint / "layouts" / f"layout{profile}.txt"


def parse_layout(text):
    """Split a layout.txt into per-layer ordered entries, preserving anything
    we don't understand verbatim so round-tripping never loses data."""
    layers = {name: [] for name in LAYERS}
    preamble = []
    current = None
    for raw_line in text.splitlines():
        stripped = raw_line.strip()
        m = LAYER_HEADER_RE.match(stripped)
        if m:
            current = m.group(1).lower()
            continue
        if current is None:
            if stripped:
                preamble.append(raw_line)
            continue
        if not stripped:
            continue
        enabled = not stripped.startswith("*")
        body = stripped[1:].strip() if not enabled else stripped
        entry = {"raw": raw_line, "enabled": enabled, "position": None, "kind": "unknown", "action": None}
        if ">" in body:
            left, right = body.split(">", 1)
            groups = GROUP_RE.findall(left)
            is_macro = "{" in left or "{" in right
            entry["position"] = groups[-1].lower() if groups else None
            entry["kind"] = "macro" if is_macro else "remap"
            if not is_macro:
                action_groups = GROUP_RE.findall(right)
                entry["action"] = action_groups[0].lower() if action_groups else None
        layers[current].append(entry)
    return {"preamble": preamble, "layers": layers}


def serialize_layout(parsed):
    lines = list(parsed["preamble"])
    for layer in LAYERS:
        if lines:
            lines.append("")
        lines.append(f"<{layer}>")
        for entry in parsed["layers"][layer]:
            lines.append(entry["raw"])
    return "\n".join(lines) + "\n"


def layer_summary(parsed):
    """{layer: {position: {kind, action, enabled}}} — last entry per position wins,
    matching the device's own conflict-resolution rule."""
    summary = {}
    for layer in LAYERS:
        positions = {}
        for entry in parsed["layers"][layer]:
            if entry["position"]:
                positions[entry["position"]] = {
                    "kind": entry["kind"], "action": entry["action"], "enabled": entry["enabled"],
                }
        summary[layer] = positions
    return summary


def cmd_read(args):
    if len(args) != 1:
        err("usage: k360 read <profile 1-9>")
    profile = int(args[0])
    path = layout_path(vdrive_mountpoint(), profile)
    text = path.read_text() if path.exists() else ""
    parsed = parse_layout(text)
    ok(profile=profile, layers=layer_summary(parsed))


def _known_positions():
    data = load_data("position_tokens.json")
    tokens = set()
    for hand in data["hands"].values():
        for group in hand.values():
            tokens.update(k["token"].lower() for k in group)
    return tokens


def _known_actions():
    return set(t.lower() for t in load_data("action_tokens.json")["tokens"].keys())


def validate_changes(changes):
    """changes: {layer: {position: action_or_null}}. Returns a list of
    human-readable problems; empty list means everything is valid."""
    problems = []
    positions = _known_positions()
    actions = _known_actions()
    for layer, remap in changes.items():
        if layer not in LAYERS:
            problems.append(f"unknown layer '{layer}'")
            continue
        for position, action in remap.items():
            if position.lower() not in positions:
                problems.append(f"unknown position token '{position}' in {layer}")
            if action is not None and action.lower() not in actions:
                problems.append(f"unknown action token '{action}' in {layer}.{position}")
    return problems


def cmd_validate(args):
    if len(args) != 1:
        err("usage: k360 validate <changes-json>")
    changes = json.loads(args[0])
    problems = validate_changes(changes)
    if problems:
        err("; ".join(problems))
    ok(valid=True)


def cmd_write(args):
    if len(args) != 2:
        err("usage: k360 write <profile 1-9> <changes-json>")
    profile = int(args[0])
    changes = json.loads(args[1])
    problems = validate_changes(changes)
    if problems:
        err("; ".join(problems))

    path = layout_path(vdrive_mountpoint(), profile)
    original = path.read_text() if path.exists() else ""
    parsed = parse_layout(original)

    for layer, remap in changes.items():
        for position, action in remap.items():
            position = position.lower()
            entries = [e for e in parsed["layers"][layer] if e["position"] != position]
            if action is not None:
                entries.append({
                    "raw": f"[{position}]>[{action.lower()}]",
                    "enabled": True, "position": position, "kind": "remap", "action": action.lower(),
                })
            parsed["layers"][layer] = entries

    new_text = serialize_layout(parsed)

    if path.exists():
        backup = path.with_name(f"{path.name}.bak.{int(time.time())}")
        backup.write_bytes(path.read_bytes())

    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(new_text)
    os.replace(tmp, path)
    ok(profile=profile, written=True)


COMMANDS = {
    "detect": cmd_detect,
    "mount": cmd_mount,
    "eject": cmd_eject,
    "read": cmd_read,
    "validate": cmd_validate,
    "write": cmd_write,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        err(f"usage: k360 <{'|'.join(COMMANDS)}> [args...]")
    COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
